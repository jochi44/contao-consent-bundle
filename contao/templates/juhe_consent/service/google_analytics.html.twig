{#
    Google Analytics 4 (gtag.js), as in Google's own snippet. service.id is the
    measurement ID ("G-" and letters or digits), checked on saving. Loads only
    after consent, like all service code. A theme overrides the block "config",
    e.g. to pass options to gtag('config', ...).
#}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ service.id|url_encode }}"></script>
<script>
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
{% block config %}gtag('config', '{{ service.id|e('js') }}');{% endblock %}
</script>
