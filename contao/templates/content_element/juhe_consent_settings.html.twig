{% extends '@Contao/content_element/_base.html.twig' %}

{#
    A theme styles the opener through button_attributes, e.g.
    {% set button_attributes = attrs().addClass('my-button') %}{{ parent() }}
    The markup is juhe_consent/opener.html.twig: a link to the privacy policy
    page (or a button without one) with data-juhe-consent-open.
#}
{% block content %}
    {% block button %}
        {% include '@Contao/juhe_consent/opener.html.twig' %}
    {% endblock %}
{% endblock %}
