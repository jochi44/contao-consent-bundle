{
    "name": "juhe-it-solutions/contao-consent-bundle",
    "description": "Consent banner and settings for Contao 6: consent groups, blocking of scripts and iframes until consent, click-to-load placeholders, anonymous consent log.",
    "type": "contao-bundle",
    "license": "proprietary",
    "authors": [{"name": "JUHE IT-solutions", "homepage": "https://www.juhe-it-solutions.at"}],
    "require": {
        "php": "^8.4",
        "contao/core-bundle": "^6.0",
        "symfony/rate-limiter": "^7.0 || ^8.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0"
    },
    "autoload": {
        "psr-4": {"JuheItSolutions\\ConsentBundle\\": "src/"}
    },
    "extra": {
        "contao-manager-plugin": "JuheItSolutions\\ConsentBundle\\ContaoManager\\Plugin"
    }
}
